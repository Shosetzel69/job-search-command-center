{
  "name": "job-search-command-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "npm --prefix ../frontend install --ignore-scripts --no-audit --no-fund && npm --prefix ../frontend run build",
    "build": "npm run build:identity && npm run build:frontend && node scripts/build-static.mjs",
    "dev": "wrangler dev",
    "test": "node --test test/*.test.mjs",
    "check": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "build:identity": "node scripts/write-build-identity.mjs",
    "db:readiness": "node scripts/db-readiness.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:privilege-readiness": "node scripts/db-privilege-readiness.mjs",
    "db:provision-runtime": "node scripts/db-provision-runtime.mjs",
    "db:nile-tenant-probe": "node scripts/db-nile-tenant-probe.mjs",
    "db:nile-contract-evidence": "node scripts/db-nile-contract-evidence.mjs",
    "check:tenant-boundary": "node scripts/check-tenant-boundary.mjs",
    "db:nile-dev-evidence": "node scripts/db-nile-dev-evidence.mjs"
  },
  "dependencies": {
    "jose": "6.2.11",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "wrangler": "4.131.1"
  }
}
