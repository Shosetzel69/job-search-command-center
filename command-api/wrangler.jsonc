{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "job-search-command-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/commands/*",
      "/config"
    ]
  },
  "vars": {
    "FRONTEND_ORIGIN": "https://job-search-command-api.myeboda.workers.dev",
    "GOOGLE_CLIENT_ID": "REPLACE_WITH_GOOGLE_CLIENT_ID",
    "GITHUB_OWNER": "Shosetzel69",
    "GITHUB_REPO": "job-search-command-center",
    "GITHUB_REF": "main",
    "GITHUB_WORKFLOW": "job-search-full.yml",
    "SEARCH_CONFIG_PATH": "data/search-config.json"
  }
}
