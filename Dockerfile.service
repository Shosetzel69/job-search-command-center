# GCP-05 / #432 + GCP-06 / #436: Cloud Run Service image for UI + authenticated Command API.
FROM node:22-bookworm-slim AS frontend-build
WORKDIR /app

COPY frontend/package.json ./frontend/package.json
RUN cd frontend && npm install --ignore-scripts --no-audit --no-fund
COPY frontend/ ./frontend/
COPY shared/ ./shared/
COPY data/ ./data/
RUN npm --prefix frontend run build

FROM node:22-bookworm-slim

ARG GIT_SHA
LABEL org.opencontainers.image.source="https://github.com/Shosetzel69/job-search-command-center" \
      org.opencontainers.image.revision="${GIT_SHA}"

ENV NODE_ENV=production
WORKDIR /app

COPY command-api/package.json ./command-api/package.json
RUN cd command-api && npm install --omit=dev --ignore-scripts --no-audit --no-fund

COPY command-api/src/ ./command-api/src/
COPY command-api/migrations/ ./command-api/migrations/
COPY command-api/scripts/db-*.mjs ./command-api/scripts/
COPY shared/ ./shared/
COPY data/sources.json data/source-categories.json data/nomenclatures.json ./data/
COPY --from=frontend-build /app/frontend/dist ./frontend/dist/

RUN printf "export const BUILD_IDENTITY = Object.freeze({\\n  sourceSha: '%s',\\n  runtimeDataSha: '%s',\\n});\\n" "${GIT_SHA}" "${GIT_SHA}" > command-api/src/build-identity.generated.js

RUN node --check command-api/src/server.js \
 && node --check command-api/src/secure-entry.js \
 && node --check command-api/src/multiuser-api.js \
 && node --check command-api/src/multiuser-repository.js \
 && node --check command-api/src/profile-evaluation.js \
 && node --check command-api/src/internal-auth-context.js \
 && node --check command-api/src/runtime-backend.js \
 && node --check command-api/src/runtime-gcp.js \
 && node --check command-api/src/index.js \
 && node --check command-api/src/db/config.js \
 && node --check command-api/src/db/pool.js \
 && node --check command-api/src/db/readiness.js \
 && node --check command-api/src/db/migrations.js \
 && node --check command-api/src/db/privilege-readiness.js \
 && node --check command-api/scripts/db-provision-runtime.mjs \
 && node --check command-api/src/static-frontend.js

EXPOSE 8080
CMD ["node", "command-api/src/server.js"]
