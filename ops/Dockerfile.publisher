# #589: separate private publisher. No Git credentials, deploy or execution authority.
FROM node:22-bookworm-slim
WORKDIR /workspace
COPY ops/package.json ./ops/package.json
RUN npm --prefix ops install --omit=dev --ignore-scripts --no-audit --no-fund
COPY ops/publisher/server.mjs ./ops/publisher/server.mjs
COPY ops/src/lib.mjs ops/src/dev_operator_contract.mjs ./ops/src/
COPY ops/observation/dev-runtime-observer.mjs ./ops/observation/
COPY ops/build/dev-cloud-build-controller.mjs ./ops/build/
COPY scripts/gcp/remote_executor_dev_publish_approval.mjs ./scripts/gcp/
ARG SOURCE_SHA
RUN printf '%s' "$SOURCE_SHA" | grep -Eq '^[a-f0-9]{40}$' \
    && printf '%s\n' "$SOURCE_SHA" > /workspace/ops/publisher-source-sha \
    && node --check ops/publisher/server.mjs
ENV SOURCE_SHA=${SOURCE_SHA} NODE_ENV=production
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["node","/workspace/ops/publisher/server.mjs"]
