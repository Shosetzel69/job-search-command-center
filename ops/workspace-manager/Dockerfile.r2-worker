# #589: reuse the independently observed immutable DEV sandbox-worker baseline.
# This is not an operator image; preserve inherited user, entrypoint and identity.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY ops/workspace-manager/service/common.py /workspace/service/common.py
COPY ops/workspace-manager/service/worker.py /workspace/service/worker.py
RUN python3 -B -c "import ast,pathlib; [ast.parse(p.read_text()) for p in pathlib.Path('/workspace/service').glob('*.py')]"
