FROM node:22-bookworm-slim
WORKDIR /workspace/ops
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund --no-save pg@8.23.0
COPY ops/nile ./nile
COPY ops/src/lib.mjs ./src/lib.mjs
COPY ops/observation/dev-runtime-observer.mjs ./observation/dev-runtime-observer.mjs
ARG SOURCE_SHA
ENV SOURCE_SHA=${SOURCE_SHA}
RUN node --check nile/worker.mjs && node --check nile/dev-nile-observer.mjs
USER node
CMD ["node","nile/worker.mjs"]
