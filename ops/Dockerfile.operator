# #589 — isolated operator image in the existing jscc-ops build lineage.
# Do not use this image for Gateway, diagnostics or sandbox identities.
FROM node:22-bookworm-slim AS node-runtime
FROM gcr.io/google.com/cloudsdktool/google-cloud-cli:stable
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-yaml \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
WORKDIR /workspace
COPY ops/src/lib.mjs ops/src/dev_operator_contract.mjs ops/src/dev_operator_gateway.mjs ./ops/src/
COPY ops/operator ./ops/operator
COPY ops/build ./ops/build
COPY ops/control ./ops/control
COPY ops/diagnostics ./ops/diagnostics
COPY ops/observation ./ops/observation
COPY scripts/gcp/remote_executor_dev_build.mjs scripts/gcp/remote_executor_dev_admission.mjs scripts/gcp/remote_executor_dev_pair.mjs scripts/gcp/remote_executor_dev_pair.py scripts/gcp/remote_executor_dev_maintenance.py scripts/gcp/remote_executor_dev_lifecycle.json scripts/gcp/cloud_run_v2_read.py ./scripts/gcp/
ARG SOURCE_SHA
RUN printf '%s' "$SOURCE_SHA" | grep -Eq '^[a-f0-9]{40} \
    && printf '%s\n' "$SOURCE_SHA" > /workspace/ops/operator-source-sha \
    && node --version && python3 -I -c 'import yaml' && gcloud --version \
    && node --check ops/operator/dev_operator_job.mjs \
    && python3 -m compileall -q scripts/gcp
ENV SOURCE_SHA=${SOURCE_SHA} HOME=/tmp CLOUDSDK_CONFIG=/tmp/jscc-operator-gcloud PYTHONDONTWRITEBYTECODE=1 CLOUDSDK_CORE_DISABLE_PROMPTS=1
USER 65532:65532
ENTRYPOINT ["node","/workspace/ops/operator/dev_operator_job.mjs"]
 \
    && printf '%s\n' "$SOURCE_SHA" > /workspace/ops/operator-source-sha \
    && node --version && python3 -I -c 'import yaml' && gcloud --version \
    && node --check ops/operator/dev_operator_job.mjs \
    && python3 -m compileall -q scripts/gcp
ENV SOURCE_SHA=${SOURCE_SHA} HOME=/tmp CLOUDSDK_CONFIG=/tmp/jscc-operator-gcloud PYTHONDONTWRITEBYTECODE=1 CLOUDSDK_CORE_DISABLE_PROMPTS=1
USER 65532:65532
ENTRYPOINT ["node","/workspace/ops/operator/dev_operator_job.mjs"]
