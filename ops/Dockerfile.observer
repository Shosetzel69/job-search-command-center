# #589 R1: isolated read-only observer. Private Cloud Run only, separate
# least-privilege service account; never expose as unauthenticated public service.
FROM node:22-bookworm-slim
WORKDIR /workspace/ops
COPY ops/src/lib.mjs ./src/lib.mjs
COPY ops/observation ./observation
ENV NODE_ENV=production
USER node
CMD ["node","observation/server.mjs"]
